# --- Local development (discrete Postgres vars) ---
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=textile_billing

# --- Hosted database (Supabase/Render Postgres etc.) ---
# If set, DATABASE_URL takes priority over the DB_* vars above and connects over SSL.
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

PORT=5000
JWT_SECRET=change_this_to_a_long_random_string
NODE_ENV=development

# Comma-separated list of allowed frontend origins in production, e.g.:
# CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=

# Supabase Storage (used for shop logo + product image uploads, and invoice PDFs)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp Cloud API (optional — send invoice PDFs directly via WhatsApp).
# Without these, "Send to WhatsApp" still works via a free wa.me link with the PDF link in the
# message text (as long as SUPABASE_URL/KEY above are set so the PDF has somewhere to live).
# See DEPLOYMENT.md for how to get these from developers.facebook.com.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=en_US
